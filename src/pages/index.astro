---
import Base from '../layouts/Base.astro';
---

<Base>
    <main id="main">
      <section class="hero section" id="top">
        <div class="container reading-width hero-layout">
          <p class="eyebrow">Product Leadership · Building · AI · Automation</p>
          <h1 class="hero-title">
            I build better products, teams, and AI-enabled ways of working.
          </h1>

          <div class="hero-module">
            <div class="hero-toggle-group" role="tablist" aria-label="Hero detail views">
              <button
                id="tab-me"
                class="hero-toggle is-active"
                type="button"
                role="tab"
                aria-selected="true"
                aria-controls="panel-me"
                tabindex="0"
                data-panel="me"
              >
                Me
              </button>
              <button
                id="tab-now"
                class="hero-toggle"
                type="button"
                role="tab"
                aria-selected="false"
                aria-controls="panel-now"
                tabindex="-1"
                data-panel="now"
              >
                Now
              </button>
            </div>

            <div class="hero-panels">
              <section
                id="panel-me"
                class="hero-panel"
                role="tabpanel"
                aria-labelledby="tab-me"
                data-panel="me"
              >
                <p class="hero-panel-label">Who I am professionally</p>
                <p class="hero-panel-copy">
                  I’m a product leader, builder, and advisor with 12+ years of experience, mainly
                  in B2B SaaS. I’ve worked across established businesses and early-stage ventures,
                  usually where the job is to turn ambiguity into better decisions, sharper
                  execution, and useful momentum.
                </p>
                <p class="hero-panel-support">
                  I bring a founder mindset, practical product judgement, and a hands-on interest
                  in building. That now includes active work with consumer-grade AI, side projects,
                  and real-world experimentation with what actually changes when these tools become
                  part of how teams operate.
                </p>
              </section>

              <section
                id="panel-now"
                class="hero-panel"
                role="tabpanel"
                aria-labelledby="tab-now"
                data-panel="now"
                hidden
              >
                <p class="hero-panel-label">What I’m focused on now</p>
                <p class="hero-panel-copy">
                  Right now I’m spending time on AI-native workflows, automation, product operating
                  models, and agent or context systems that make modern tools genuinely useful in
                  day-to-day work.
                </p>
                <p class="hero-panel-support">
                  The thread running through it is simple: understanding what AI changes for
                  product, growth, and operations, and how to use that change well rather than just
                  shipping superficial features.
                </p>
              </section>
            </div>
          </div>

          <div class="hero-actions">
            <a class="button button-primary" href="#path">Read my path</a>
            <a class="button button-secondary" href="https://www.linkedin.com/in/davidwbarnesmsc/" target="_blank" rel="noreferrer">
              LinkedIn
            </a>
          </div>
          <p class="hero-handoff">
            Coaching founders? Find me at
            <a href="https://z2n.uk" target="_blank" rel="noreferrer">Zero to N →</a>
          </p>
        </div>
      </section>

      <section class="section section-divider" id="outcomes" aria-labelledby="outcomes-title">
        <div class="container reading-width">
          <div class="section-heading reveal">
            <p class="section-kicker">Selected outcomes</p>
            <h2 id="outcomes-title">Evidence over theatre.</h2>
          </div>
          <div class="outcomes-list">
            <article class="outcome-card reveal">
              <h3>Enterprise workflow integrations</h3>
              <p>Influenced roughly 90% of new-business pipeline through enterprise workflow integrations.</p>
            </article>
            <article class="outcome-card reveal">
              <h3>AI-assisted content operations</h3>
              <p>Reduced AI-assisted content creation from days or weeks to hours.</p>
            </article>
            <article class="outcome-card reveal">
              <h3>Faster delivery cycles</h3>
              <p>Cut project duration from six weeks to three and increased iteration capacity.</p>
            </article>
            <article class="outcome-card reveal">
              <h3>Commercial responsibility</h3>
              <p>Owned a £60m portfolio with 60% gross margin and full P&amp;L responsibility.</p>
            </article>
            <article class="outcome-card reveal">
              <h3>Greenfield to revenue</h3>
              <p>Took a greenfield product to first paying customers within 12 months.</p>
            </article>
          </div>
        </div>
      </section>

